load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:rules.bzl", "genassym")
load("//bazel:mig.bzl", "mig_library")

package(default_visibility = ["//visibility:public"])

# Common kernel flags from root
COMMON_KERNEL_FLAGS = [
    "-I./",
    "-nostdlibinc",
    "-fno-builtin",
    "-fno-common",
    "-DAPPLE=1",
    "-DKERNEL=1",
    "-D_KERNEL=1",
    "-DKERNEL_SERVER=1",
    "-DKERNEL_PRIVATE=1",
    "-DXNU_KERNEL_PRIVATE=1",
    "-DMACH_KERNEL_PRIVATE=1",
    "-DMACH_BSD=1",
    "-DMACH_KDP=1",
    "-DPRIVATE=1",
    "-DXNU_TARGET_OS_OSX=1",
    "-D__MACHO__=1",
    "-fblocks",
    "-DCONFIG_SCHED_TRADITIONAL=1",
    "-DCONFIG_SCHED_MULTIQ=1",
    "-DCONFIG_SCHED_CLUTCH=1",
    "-DCONFIG_SCHED_TIMESHARE_CORE=1",
    "-DCONFIG_THREAD_MAX=2560",
    "-DCONFIG_TASK_MAX=1024",
    "-DKPERF=1",
    "-DCONFIG_SLEEP=1",
    "-DHIBERNATION=1",
    "-DCC_INTERNAL_SDK=1",
]

X86_64_FLAGS = [
    "-target", "x86_64-apple-darwin",
    "-Dx86_64",
    "-DX86_64",
    "-D__X86_64__",
    "-DLP64",
    "-DPAGE_SIZE_FIXED",
    "-DKERNEL_BASE_OFFSET=0x100000",
    "-mkernel",
    "-msoft-float",
]

BOOT_INCLUDE_FLAGS = [
    "-Iosfmk",
    "-Iosfmk/console",
    "-Iosfmk/i386",
    "-Iosfmk/x86_64",
    "-Iosfmk/kern",
    "-Iosfmk/mach",
    "-Iosfmk/libsa",
    "-Ibsd",
    "-Ipexpert",
    "-IEXTERNAL_HEADERS",
    "-Ibuild_config",
    "-Iiokit",
    "-Ilibkern",
    "-Ibazel-out/k8-fastbuild/bin/osfmk",
]

filegroup(
    name = "osfmk_headers",
    srcs = glob(["**/*.h"]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "system_mach_headers",
    hdrs = glob(["mach/**/*.h"]),
    include_prefix = "System/mach",
    strip_include_prefix = "mach",
    visibility = ["//visibility:public"],
)

genassym(
    name = "assym_s",
    src = "i386/genassym.c",
    out = "assym.s",
    copts = COMMON_KERNEL_FLAGS + X86_64_FLAGS,
    hdrs = ["//:all_headers", "//:config_header_files"],
    includes = [
        "build_config",
        "osfmk",
        "bsd",
        "osfmk/libsa",
        "osfmk/kern",
        "osfmk/mach",
        "osfmk/i386",
        "osfmk/x86_64",
        "libkern",
        "EXTERNAL_HEADERS",
        "pexpert",
        "iokit",
    ],
    deps = ["//:common_headers"],
)

genrule(
    name = "debug_sandbox",
    srcs = ["//:all_headers"],
    outs = ["sandbox_listing.txt"],
    cmd = "find . -maxdepth 5 > $@",
)

genrule(
    name = "start_S",
    srcs = ["x86_64/start.s"],
    outs = ["x86_64/start.S"],
    cmd = "cp $< $@",
)

cc_library(
    name = "osfmk_start",
    srcs = [
        "x86_64/start.S",
        "x86_64/machine_routines_asm.s",
    ],
    hdrs = [":assym_s"],
    copts = COMMON_KERNEL_FLAGS + X86_64_FLAGS + BOOT_INCLUDE_FLAGS + ["-DASSEMBLER"],
    includes = [".", "console"],
    deps = ["//:common_headers", ":osfmk_start_c"],
    linkstatic = True,
)

cc_library(
    name = "osfmk_start_c",
    srcs = [
        "console/serial_console.c",
        "console/serial_general.c",
        "console/video_console.c",
        "x86_64/bcopy.s",
        "i386/AT386/model_dep.c",
        "i386/Diagnostics.c",
        "i386/acpi.c",
        "i386/cpu.c",
        "i386/cpu_threads.c",
        "i386/cpuid.c",
        "i386/fpu.c",
        "x86_64/boot_pt.c",
        "i386/gdt.c",
        "i386/i386_init.c",
        "i386/i386_vm_init.c",
        "i386/hibernate_restore.c",
        "i386/lapic.c",
        "i386/lapic_native.c",
        "i386/machine_routines.c",
        "i386/mp.c",
        "i386/mp_desc.c",
        "i386/pal_routines.c",
        "i386/pcb.c",
        "i386/pcb_native.c",
        "i386/panic_hooks.c",
        "i386/panic_notify.c",
        "i386/pmap_x86_common.c",
        "i386/pmCPU.c",
        "i386/rtclock.c",
        "i386/tsc.c",
        "i386/ucode.c",
        "kern/clock.c",
        "kern/debug.c",
        "kern/locks.c",
        "kern/machine.c",
        "kern/processor.c",
        "kern/printf.c",
        "kern/sched_prim.c",
        "kern/startup.c",
        "kern/thread.c",
        "kern/timer_call.c",
        "prng/prng_random.c",
        "x86_64/loose_ends.c",
        "x86_64/pmap.c",
        "//:libkern/stack_protector.c",
    ],
    textual_hdrs = [
        "console/iso_font.c",
        "console/progress_meter_data.c",
    ],
    copts = COMMON_KERNEL_FLAGS + X86_64_FLAGS + BOOT_INCLUDE_FLAGS,
    includes = [".", "console"],
    deps = ["//:common_headers", "//:config_headers", "//:crc32_support", "//:early_string_support", "//:early_vm_support", "//:kernel_version_support", "//:pexpert_kprintf_support"],
    linkstatic = True,
)

