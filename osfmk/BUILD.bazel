load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:rules.bzl", "genassym")
load("//bazel:mig.bzl", "mig_library")
load("//bazel:kernel_config.bzl", "X86_64_FLAGS", _BASE_KERNEL_FLAGS = "COMMON_KERNEL_FLAGS")

package(default_visibility = ["//visibility:public"])

COMMON_KERNEL_FLAGS = _BASE_KERNEL_FLAGS + [
    "-DKERNEL_SERVER=1",
    "-DCONFIG_SLEEP=1",
    "-DCONFIG_DTRACE=1",
    "-DHIBERNATION=1",
]

BOOT_INCLUDE_FLAGS = [
    "-Iosfmk",
    "-Iosfmk/console",
    "-Iosfmk/i386",
    "-Iosfmk/x86_64",
    "-Iosfmk/kern",
    "-Iosfmk/mach",
    "-Iosfmk/libsa",
    "-Ibsd",
    "-Ipexpert",
    "-IEXTERNAL_HEADERS",
    "-Ibuild_config",
    "-I$(BINDIR)/build_config",
    "-Iiokit",
    "-Ilibkern",
    "-I$(BINDIR)/osfmk",
    "-I$(BINDIR)/bsd",
]

filegroup(
    name = "osfmk_headers",
    srcs = glob(["**/*.h"]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "system_mach_headers",
    hdrs = glob(["mach/**/*.h"]),
    include_prefix = "System/mach",
    strip_include_prefix = "mach",
    visibility = ["//visibility:public"],
)

genassym(
    name = "assym_s",
    src = "i386/genassym.c",
    out = "assym.s",
    copts = COMMON_KERNEL_FLAGS + X86_64_FLAGS,
    hdrs = ["//:all_headers", "//:config_header_files"],
    includes = [
        "build_config",
        "osfmk",
        "bsd",
        "osfmk/libsa",
        "osfmk/kern",
        "osfmk/mach",
        "osfmk/i386",
        "osfmk/x86_64",
        "libkern",
        "EXTERNAL_HEADERS",
        "pexpert",
        "iokit",
    ],
    deps = ["//:common_headers"],
)

genrule(
    name = "debug_sandbox",
    srcs = ["//:all_headers"],
    outs = ["sandbox_listing.txt"],
    cmd = "find . -maxdepth 5 > $@",
)

genrule(
    name = "start_S",
    srcs = ["x86_64/start.s"],
    outs = ["x86_64/start.S"],
    cmd = "cp $< $@",
)

cc_library(
    name = "osfmk_start",
