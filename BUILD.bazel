    copts = COMMON_KERNEL_FLAGS + X86_64_FLAGS,
    deps = [":config_headers", ":san_memintrinsics", ":san_kcov_headers", "//osfmk:system_mach_headers", "//osfmk:clock_headers"],
)

cc_library(
    name = "pexpert_headers",
    hdrs = [":all_headers"],
    includes = [
        "build_config",
        "EXTERNAL_HEADERS",
        "libkern",
        "libkern/libkern",
        "osfmk",
        "osfmk/kern",
        "osfmk/mach",
        "bsd",
        "san/memory",
        "iokit",
        "pexpert",
        "osfmk/i386",
        "osfmk/x86_64",
